---
import { url, formatDate, readingTime } from '../utils/url';
import type { CollectionEntry } from 'astro:content';
interface Props { post: CollectionEntry<'blog'>; }
const { post } = Astro.props;
---
<article class="reveal card card-hover group p-6 flex flex-col h-full">
  <p class="font-mono text-xs text-muted">{formatDate(post.data.date)} · {readingTime(post.body)}</p>
  <h3 class="mt-3 font-display font-semibold text-xl leading-snug group-hover:text-cyan transition-colors">
    <a href={url(`/blog/${post.id}`)} class="after:absolute after:inset-0">{post.data.title}</a>
  </h3>
  <p class="mt-3 text-sm text-muted leading-relaxed flex-1">{post.data.description}</p>
  <div class="mt-4 flex flex-wrap gap-1.5">{post.data.tags.map((t) => <span class="chip">#{t}</span>)}</div>
</article>
