---
/**
 * Hero background: a simulated real-time object detector.
 * Line-art objects drift across the hero while YOLO-style boxes track them with
 * class labels + confidence. The visitor's cursor is detected as "recruiter".
 * Clicking spawns a new object. All colours come from CSS theme tokens, so it
 * works in light and dark mode.
 */
---
<canvas id="detection-canvas" class="absolute inset-0 w-full h-full" aria-hidden="true"></canvas>

<script>
  type Cls = 'car' | 'phone' | 'chip' | 'traffic light' | 'drone' | 'laptop' | 'person' | 'bicycle';
  type Tone = 'cyan' | 'violet' | 'amber';
  type Box = { x: number; y: number; w: number; h: number };
  type Obj = {
    cls: Cls; x: number; y: number; vx: number; vy: number; s: number; phase: number;
    det: Box; shown: Box; conf: number; born: number; spawned: boolean;
  };

  const CLASSES: Record<Cls, { w: number; h: number; tone: Tone }> = {
    car: { w: 1.8, h: 0.95, tone: 'cyan' },
    phone: { w: 0.62, h: 1.15, tone: 'violet' },
    chip: { w: 1.1, h: 1.1, tone: 'amber' },
    'traffic light': { w: 0.5, h: 1.3, tone: 'amber' },
    drone: { w: 1.7, h: 0.7, tone: 'cyan' },
    laptop: { w: 1.55, h: 1.0, tone: 'violet' },
    person: { w: 0.7, h: 1.45, tone: 'cyan' },
    bicycle: { w: 1.7, h: 1.0, tone: 'violet' },
  };
  const NAMES = Object.keys(CLASSES) as Cls[];

  const canvas = document.getElementById('detection-canvas') as HTMLCanvasElement;
  const ctx = canvas.getContext('2d')!;
  const host = canvas.parentElement as HTMLElement;
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  let W = 0, H = 0, mobile = false, textRight = 0;
  let objs: Obj[] = [];
  let col = { cyan: '#22d3ee', violet: '#a78bfa', amber: '#f5a524', muted: '#8d99b8', bg: '#070b16', fg: '#e6ebf7', dark: true };
  let running = true, last = 0, time = 0, inferTimer = 0;
  let fps = 30, frames = 0, fpsTimer = 0, latency = 14;
  const cursor = { x: 0, y: 0, active: false, until: 0, shown: null as Box | null, conf: 0.99 };
  const pulses: { x: number; y: number; t: number }[] = [];

  const rand = (a: number, b: number) => a + Math.random() * (b - a);
  const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

  function readColors() {
    const s = getComputedStyle(document.documentElement);
    const v = (n: string, d: string) => s.getPropertyValue(n).trim() || d;
    col = {
      cyan: v('--cyan', col.cyan), violet: v('--violet', col.violet), amber: v('--amber', col.amber),
      muted: v('--muted', col.muted), bg: v('--bg', col.bg), fg: v('--fg', col.fg),
      dark: document.documentElement.classList.contains('dark'),
    };
  }

  /** Region where objects live: right side on desktop (keeps text readable), full width on mobile. */
  function region() {
    return mobile
      ? { x0: 0, x1: W, y0: H * 0.1, y1: H * 0.95 }
      : { x0: Math.max(W * 0.5, Math.min(textRight + 40, W - 380)), x1: W, y0: H * 0.14, y1: H * 0.9 };
  }

  function bboxOf(o: Obj): Box {
    const c = CLASSES[o.cls];
    const w = c.w * o.s + 16, h = c.h * o.s + 16;
    const bob = Math.sin(time * 1.2 + o.phase) * 4;
    return { x: o.x - w / 2, y: o.y + bob - h / 2, w, h };
  }

  function makeObj(cls: Cls, x: number, y: number, spawned = false): Obj {
    const s = mobile ? rand(26, 38) : rand(34, 54);
    const dir = Math.random() < 0.5 ? -1 : 1;
    const o: Obj = {
      cls, x, y, s, phase: rand(0, Math.PI * 2), spawned, born: time,
      vx: dir * rand(8, 22), vy: rand(-3, 3),
      det: { x, y, w: 0, h: 0 }, shown: { x, y, w: 0, h: 0 }, conf: rand(0.9, 0.99),
    };
    o.det = bboxOf(o);
    o.shown = spawned ? { x: x - 4, y: y - 4, w: 8, h: 8 } : { ...o.det };
    return o;
  }

  function build() {
    const rect = canvas.getBoundingClientRect();
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    W = rect.width; H = rect.height; mobile = W < 768;
    // Keep objects to the right of the hero text column so the text stays readable
    const text = host.querySelector('[data-hero-text]');
    textRight = text ? text.getBoundingClientRect().right - rect.left : W * 0.5;
    canvas.width = W * dpr; canvas.height = H * dpr;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

    const r = region();
    const n = mobile ? 5 : 8;
    const cols = mobile ? 2 : 3;
    const rows = Math.ceil(n / cols);
    objs = Array.from({ length: n }, (_, i) => {
      const cx = r.x0 + ((r.x1 - r.x0) * ((i % cols) + 0.5)) / cols + rand(-30, 30);
      const cy = r.y0 + ((r.y1 - r.y0) * (Math.floor(i / cols) + 0.5)) / rows + rand(-20, 20);
      return makeObj(NAMES[i % NAMES.length], cx, cy);
    });
  }

  /* ───────────── Line-art icons, centred at (0,0), scale s ───────────── */
  function rr(x: number, y: number, w: number, h: number, r: number) {
    ctx.beginPath(); ctx.roundRect(x, y, w, h, r);
  }
  function drawIcon(o: Obj) {
    const s = o.s;
    const bob = Math.sin(time * 1.2 + o.phase) * 4;
    ctx.save();
    ctx.translate(o.x, o.y + bob);
    ctx.strokeStyle = col.muted;
    ctx.lineWidth = 1.6;
    ctx.lineJoin = 'round'; ctx.lineCap = 'round';
    switch (o.cls) {
      case 'car': {
        rr(-0.9 * s, -0.05 * s, 1.8 * s, 0.4 * s, 0.12 * s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-0.55 * s, -0.05 * s); ctx.lineTo(-0.35 * s, -0.42 * s); ctx.lineTo(0.3 * s, -0.42 * s); ctx.lineTo(0.55 * s, -0.05 * s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-0.02 * s, -0.42 * s); ctx.lineTo(-0.02 * s, -0.05 * s); ctx.stroke();
        for (const wx of [-0.5, 0.5]) { ctx.beginPath(); ctx.arc(wx * s, 0.36 * s, 0.13 * s, 0, Math.PI * 2); ctx.stroke(); }
        break;
      }
      case 'phone': {
        rr(-0.31 * s, -0.57 * s, 0.62 * s, 1.14 * s, 0.1 * s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-0.08 * s, -0.47 * s); ctx.lineTo(0.08 * s, -0.47 * s); ctx.stroke();
        ctx.beginPath(); ctx.arc(0, 0.44 * s, 0.04 * s, 0, Math.PI * 2); ctx.stroke();
        break;
      }
      case 'chip': {
        rr(-0.38 * s, -0.38 * s, 0.76 * s, 0.76 * s, 0.06 * s); ctx.stroke();
        rr(-0.18 * s, -0.18 * s, 0.36 * s, 0.36 * s, 0.03 * s); ctx.stroke();
        ctx.beginPath();
        for (const p of [-0.22, 0, 0.22]) {
          ctx.moveTo(p * s, -0.38 * s); ctx.lineTo(p * s, -0.55 * s);
          ctx.moveTo(p * s, 0.38 * s); ctx.lineTo(p * s, 0.55 * s);
          ctx.moveTo(-0.38 * s, p * s); ctx.lineTo(-0.55 * s, p * s);
          ctx.moveTo(0.38 * s, p * s); ctx.lineTo(0.55 * s, p * s);
        }
        ctx.stroke();
        break;
      }
      case 'traffic light': {
        rr(-0.25 * s, -0.65 * s, 0.5 * s, 1.1 * s, 0.1 * s); ctx.stroke();
        const lights: Tone[] = ['amber', 'amber', 'cyan'];
        const on = Math.floor((time + o.phase) / 2) % 3;
        [-0.4, -0.1, 0.2].forEach((ly, i) => {
          ctx.beginPath(); ctx.arc(0, ly * s, 0.1 * s, 0, Math.PI * 2);
          if (i === on) { ctx.fillStyle = col[lights[i]]; ctx.globalAlpha *= 0.8; ctx.fill(); ctx.globalAlpha /= 0.8; }
          ctx.stroke();
        });
        ctx.beginPath(); ctx.moveTo(0, 0.45 * s); ctx.lineTo(0, 0.65 * s); ctx.stroke();
        break;
      }
      case 'drone': {
        rr(-0.18 * s, -0.1 * s, 0.36 * s, 0.2 * s, 0.06 * s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-0.18 * s, 0); ctx.lineTo(-0.6 * s, -0.12 * s); ctx.moveTo(0.18 * s, 0); ctx.lineTo(0.6 * s, -0.12 * s); ctx.stroke();
        const spin = Math.abs(Math.sin(time * 18 + o.phase));
        for (const rx of [-0.6, 0.6]) { ctx.beginPath(); ctx.ellipse(rx * s, -0.2 * s, 0.25 * s * (0.4 + 0.6 * spin), 0.05 * s, 0, 0, Math.PI * 2); ctx.stroke(); }
        break;
      }
      case 'laptop': {
        rr(-0.55 * s, -0.5 * s, 1.1 * s, 0.7 * s, 0.05 * s); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-0.77 * s, 0.3 * s); ctx.lineTo(0.77 * s, 0.3 * s); ctx.lineTo(0.68 * s, 0.45 * s); ctx.lineTo(-0.68 * s, 0.45 * s); ctx.closePath(); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(-0.35 * s, -0.25 * s); ctx.lineTo(0.1 * s, -0.25 * s); ctx.moveTo(-0.35 * s, -0.08 * s); ctx.lineTo(0.3 * s, -0.08 * s); ctx.stroke();
        break;
      }
      case 'person': {
        const swing = Math.sin(time * 4 + o.phase) * 0.15;
        ctx.beginPath(); ctx.arc(0, -0.55 * s, 0.14 * s, 0, Math.PI * 2); ctx.stroke();
        ctx.beginPath(); ctx.moveTo(0, -0.4 * s); ctx.lineTo(0, 0.2 * s);
        ctx.moveTo(0, -0.25 * s); ctx.lineTo(-0.28 * s, (0.02 + swing) * s); ctx.moveTo(0, -0.25 * s); ctx.lineTo(0.28 * s, (0.02 - swing) * s);
        ctx.moveTo(0, 0.2 * s); ctx.lineTo((-0.2 - swing) * s, 0.68 * s); ctx.moveTo(0, 0.2 * s); ctx.lineTo((0.2 + swing) * s, 0.68 * s);
        ctx.stroke();
        break;
      }
      case 'bicycle': {
        for (const wx of [-0.5, 0.5]) { ctx.beginPath(); ctx.arc(wx * s, 0.2 * s, 0.28 * s, 0, Math.PI * 2); ctx.stroke(); }
        ctx.beginPath();
        ctx.moveTo(-0.5 * s, 0.2 * s); ctx.lineTo(-0.1 * s, -0.25 * s); ctx.lineTo(0.35 * s, -0.25 * s); ctx.lineTo(0.5 * s, 0.2 * s);
        ctx.moveTo(-0.1 * s, -0.25 * s); ctx.lineTo(0.05 * s, 0.2 * s); ctx.lineTo(0.35 * s, -0.25 * s);
        ctx.moveTo(-0.5 * s, 0.2 * s); ctx.lineTo(0.05 * s, 0.2 * s);
        ctx.moveTo(-0.18 * s, -0.38 * s); ctx.lineTo(0, -0.38 * s); ctx.moveTo(0.35 * s, -0.25 * s); ctx.lineTo(0.3 * s, -0.42 * s); ctx.lineTo(0.42 * s, -0.42 * s);
        ctx.stroke();
        break;
      }
    }
    ctx.restore();
  }

  /* ───────────── Detection box ───────────── */
  function drawBox(b: Box, label: string, color: string, alpha: number) {
    if (b.w < 2) return;
    const L = Math.min(12, b.w / 3, b.h / 3);
    ctx.save();
    ctx.globalAlpha = alpha * 0.35;
    ctx.strokeStyle = color; ctx.lineWidth = 1;
    ctx.strokeRect(b.x, b.y, b.w, b.h);
    ctx.globalAlpha = alpha;
    ctx.lineWidth = 2.2;
    ctx.beginPath();
    ctx.moveTo(b.x, b.y + L); ctx.lineTo(b.x, b.y); ctx.lineTo(b.x + L, b.y);
    ctx.moveTo(b.x + b.w - L, b.y); ctx.lineTo(b.x + b.w, b.y); ctx.lineTo(b.x + b.w, b.y + L);
    ctx.moveTo(b.x + b.w, b.y + b.h - L); ctx.lineTo(b.x + b.w, b.y + b.h); ctx.lineTo(b.x + b.w - L, b.y + b.h);
    ctx.moveTo(b.x + L, b.y + b.h); ctx.lineTo(b.x, b.y + b.h); ctx.lineTo(b.x, b.y + b.h - L);
    ctx.stroke();
    // label tag
    ctx.font = '500 11px "JetBrains Mono", ui-monospace, monospace';
    const tw = ctx.measureText(label).width + 10;
    const ty = b.y - 18 < 0 ? b.y : b.y - 18;
    ctx.fillStyle = color;
    ctx.beginPath(); ctx.roundRect(b.x - 1, ty, tw, 17, 3); ctx.fill();
    ctx.fillStyle = col.bg;
    ctx.textBaseline = 'middle';
    ctx.fillText(label, b.x + 4, ty + 9);
    ctx.restore();
  }

  function edgeAlpha(o: Obj) {
    const r = region();
    const d = Math.min(o.x - r.x0, r.x1 - o.x);
    return Math.max(0, Math.min(1, d / 80));
  }

  function step(dt: number) {
    time += dt;
    const r = region();
    for (const o of objs) {
      o.x += o.vx * dt; o.y += o.vy * dt;
      if (o.y < r.y0 + 20 || o.y > r.y1 - 20) o.vy *= -1;
      const m = 90;
      if (o.x > r.x1 + m) o.x = r.x0 - m + 10;
      if (o.x < r.x0 - m) o.x = r.x1 + m - 10;
    }
    // "Inference" runs at ~12 Hz: detections update with a little noise, like a real model
    inferTimer -= dt;
    if (inferTimer <= 0) {
      inferTimer = 0.08;
      latency = lerp(latency, rand(9, 18), 0.3);
      for (const o of objs) {
        const b = bboxOf(o);
        o.det = { x: b.x + rand(-2, 2), y: b.y + rand(-2, 2), w: b.w + rand(-3, 3), h: b.h + rand(-3, 3) };
        o.conf = Math.min(0.99, Math.max(0.88, o.conf + rand(-0.02, 0.02)));
      }
      cursor.conf = rand(0.97, 0.995);
    }
    for (const o of objs) {
      const k = Math.min(1, dt * 10);
      o.shown = { x: lerp(o.shown.x, o.det.x, k), y: lerp(o.shown.y, o.det.y, k), w: lerp(o.shown.w, o.det.w, k), h: lerp(o.shown.h, o.det.h, k) };
    }
    if (cursor.shown) {
      const k = Math.min(1, dt * 12);
      const t = { x: cursor.x - 42, y: cursor.y - 42, w: 84, h: 84 };
      cursor.shown = { x: lerp(cursor.shown.x, t.x, k), y: lerp(cursor.shown.y, t.y, k), w: lerp(cursor.shown.w, t.w, k), h: lerp(cursor.shown.h, t.h, k) };
    }
    for (let i = pulses.length - 1; i >= 0; i--) { pulses[i].t += dt; if (pulses[i].t > 0.8) pulses.splice(i, 1); }
    // FPS meter
    frames++; fpsTimer += dt;
    if (fpsTimer >= 0.5) { fps = Math.round(frames / fpsTimer); frames = 0; fpsTimer = 0; }
  }

  function draw() {
    ctx.clearRect(0, 0, W, H);
    const base = mobile ? 0.55 : 1;
    const r = region();

    // Scan line sweeping across the detection region every few seconds
    const cycle = (time % 5) / 1.4;
    if (cycle < 1) {
      const sx = r.x0 + (r.x1 - r.x0) * cycle;
      const g = ctx.createLinearGradient(sx - 60, 0, sx, 0);
      g.addColorStop(0, 'transparent'); g.addColorStop(1, col.cyan);
      ctx.globalAlpha = 0.12 * base;
      ctx.fillStyle = g;
      ctx.fillRect(sx - 60, r.y0 - 30, 60, r.y1 - r.y0 + 60);
      ctx.globalAlpha = 1;
    }

    for (const o of objs) {
      const a = edgeAlpha(o) * base;
      const age = Math.min(1, (time - o.born) / 0.4);
      ctx.globalAlpha = a * (col.dark ? 0.75 : 0.85) * age;
      drawIcon(o);
      ctx.globalAlpha = 1;
      drawBox(o.shown, `${o.cls} ${o.conf.toFixed(2)}`, col[CLASSES[o.cls].tone], a * 0.95 * age);
    }

    for (const p of pulses) {
      const k = p.t / 0.8, size = 20 + k * 90;
      ctx.globalAlpha = (1 - k) * 0.7;
      ctx.strokeStyle = col.violet; ctx.lineWidth = 1.5;
      ctx.strokeRect(p.x - size / 2, p.y - size / 2, size, size);
      ctx.globalAlpha = 1;
    }

    const cursorVisible = cursor.active || performance.now() < cursor.until;
    if (cursorVisible && cursor.shown) drawBox(cursor.shown, `recruiter ${cursor.conf.toFixed(2)}`, col.violet, 1);

    // HUD
    if (!mobile) {
      ctx.save();
      ctx.font = '500 11px "JetBrains Mono", ui-monospace, monospace';
      ctx.textAlign = 'right'; ctx.textBaseline = 'top';
      ctx.fillStyle = col.muted;
      ctx.globalAlpha = 0.9;
      const n = objs.length + (cursorVisible ? 1 : 0);
      const hud = `LIVE  model: object-detector  ·  ${fps} FPS  ·  ${latency.toFixed(0)} ms  ·  ${n} objects`;
      ctx.fillText(hud, W - 24, 84);
      ctx.fillStyle = col.cyan;
      ctx.globalAlpha = 0.5 + 0.5 * Math.abs(Math.sin(time * 2.5));
      ctx.beginPath(); ctx.arc(W - 24 - ctx.measureText(hud).width - 9, 90, 3.5, 0, Math.PI * 2); ctx.fill();
      ctx.restore();
    }
  }

  function loop(ts: number) {
    if (!running) return;
    const dt = Math.min(0.05, (ts - last) / 1000 || 0.016);
    last = ts;
    step(dt);
    draw();
    requestAnimationFrame(loop);
  }
  function start() { if (!running && !reduced) { running = true; last = performance.now(); requestAnimationFrame(loop); } }
  function stop() { running = false; }

  /* ───────────── Interaction ───────────── */
  function local(e: PointerEvent) {
    const rect = canvas.getBoundingClientRect();
    return { x: e.clientX - rect.left, y: e.clientY - rect.top };
  }
  host.addEventListener('pointermove', (e) => {
    const p = local(e);
    cursor.x = p.x; cursor.y = p.y;
    if (e.pointerType === 'mouse') {
      if (!cursor.active || !cursor.shown) cursor.shown = { x: p.x - 6, y: p.y - 6, w: 12, h: 12 };
      cursor.active = true;
    }
  });
  host.addEventListener('pointerleave', () => { cursor.active = false; });
  host.addEventListener('pointerdown', (e) => {
    if ((e.target as HTMLElement).closest('a, button')) return;
    const p = local(e);
    cursor.x = p.x; cursor.y = p.y;
    if (e.pointerType !== 'mouse') { cursor.shown = { x: p.x - 6, y: p.y - 6, w: 12, h: 12 }; cursor.until = performance.now() + 1500; }
    const o = makeObj(NAMES[Math.floor(Math.random() * NAMES.length)], p.x, p.y, true);
    // keep newly spawned objects inside the region so they are visible
    const r = region();
    o.x = Math.min(Math.max(o.x, r.x0 + 60), r.x1 - 60);
    objs.push(o);
    pulses.push({ x: p.x, y: p.y, t: 0 });
    const spawned = objs.filter((x) => x.spawned);
    if (spawned.length > 6) objs.splice(objs.indexOf(spawned[0]), 1);
    if (reduced) draw();
  });

  readColors();
  build();
  if (reduced) {
    running = false;
    step(0);
    draw();
  } else {
    requestAnimationFrame(loop);
    new IntersectionObserver(([e]) => (e.isIntersecting ? start() : stop())).observe(canvas);
    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : start()));
  }

  let rt: number | undefined;
  window.addEventListener('resize', () => {
    clearTimeout(rt);
    rt = window.setTimeout(() => { build(); if (reduced) draw(); }, 150);
  });
  new MutationObserver(() => { readColors(); if (reduced) draw(); }).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
</script>
