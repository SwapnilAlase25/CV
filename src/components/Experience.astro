---
import SectionHeading from './SectionHeading.astro';
import { experience } from '../data/profile';

const ai = experience.filter((j) => j.track === 'ai');
const embedded = experience.filter((j) => j.track === 'embedded');
---
<section id="experience" class="mx-auto max-w-6xl px-4 sm:px-6 py-8 sm:py-10 lg:py-16">
  <SectionHeading label="02 · Experience" title="Where I’ve worked" subtitle="AI today, built on a foundation of production automotive engineering." />

  {ai.map((job) => (
    <article class="reveal card p-[1px] !border-0 bg-gradient-to-br from-cyan/60 via-violet/40 to-transparent mb-8">
      <div class="rounded-[15px] bg-card p-6 sm:p-10">
        <div class="flex flex-wrap items-center gap-3">
          <span class="chip chip-ai">AI · current</span>
          <span class="text-sm text-muted">{job.company}{job.team && ` · ${job.team}`}{job.location && ` · ${job.location}`}</span>
        </div>
        {job.roles.map((r) => (
          <div class="mt-5">
            <h3 class="font-display font-bold text-2xl sm:text-3xl"><span class="text-gradient-ai">{r.title}</span> <span class="text-muted font-medium">@ {job.company}</span></h3>
            <p class="mt-3 text-muted leading-relaxed">{job.headline}</p>
            <ul class="mt-5 space-y-3">
              {r.points.map((p) => (
                <li class="flex gap-3 leading-relaxed"><span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan"></span><span>{p}</span></li>
              ))}
            </ul>
          </div>
        ))}
        <div class="mt-6 flex flex-wrap gap-2">{job.tech.map((t) => <span class="chip chip-ai">{t}</span>)}</div>
      </div>
    </article>
  ))}

  <h3 class="reveal font-mono text-xs uppercase tracking-widest text-amber mb-5">Engineering foundation · Embedded</h3>
  <div class="grid md:grid-cols-2 md:items-start gap-6">
    {embedded.map((job) => (
      <article class="reveal card card-hover p-6 sm:p-8">
        <div class="flex items-center justify-between gap-3">
          <h4 class="font-display font-semibold text-xl">{job.company}</h4>
          <span class="chip chip-embedded">Embedded</span>
        </div>
        <p class="mt-2 text-sm text-muted">{job.headline}</p>
        <div class="mt-5 space-y-5">
          {job.roles.map((r) => (
            <div>
              <p class="font-medium text-fg">{r.title}</p>
              <ul class="mt-2 space-y-1.5">
                {r.points.map((p) => <li class="flex gap-2.5 text-sm text-muted leading-relaxed"><span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-amber"></span><span>{p}</span></li>)}
              </ul>
            </div>
          ))}
        </div>
        <div class="mt-5 flex flex-wrap gap-2">{job.tech.map((t) => <span class="chip">{t}</span>)}</div>
      </article>
    ))}
  </div>
</section>
