---
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { url } from '../utils/url';
const year = new Date().getFullYear();
---
<footer class="relative z-10 border-t border-line mt-24">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 flex flex-col sm:flex-row items-center justify-between gap-4 text-sm text-muted">
    <p>© {year} {profile.name}. Built with Astro · hosted on GitHub Pages.</p>
    <div class="flex items-center gap-4">
      <a href={profile.socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-cyan"><Icon name="linkedin" /></a>
      <a href={profile.socials.github} target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-cyan"><Icon name="github" /></a>
      <a href={`mailto:${profile.email}`} aria-label="Email" class="hover:text-cyan"><Icon name="mail" /></a>
      <a href={url('/rss.xml')} aria-label="RSS feed" class="hover:text-cyan"><Icon name="rss" /></a>
    </div>
  </div>
</footer>
