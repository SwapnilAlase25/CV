---
import { Image } from 'astro:assets';
import portrait from '../assets/profile.webp';
import DetectionCanvas from './DetectionCanvas.astro';
import Icon from './Icon.astro';
import { profile } from '../data/profile';
import { url } from '../utils/url';
---
<section class="relative min-h-[100svh] flex flex-col justify-center overflow-hidden">
  <div class="absolute inset-0 bg-grid" aria-hidden="true"></div>
  <DetectionCanvas />
  <div class="absolute inset-0 pointer-events-none bg-gradient-to-r from-bg via-bg/70 to-transparent md:via-bg/40" aria-hidden="true"></div>
  <div class="absolute inset-x-0 bottom-0 h-32 pointer-events-none bg-gradient-to-t from-bg to-transparent" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-6xl w-full px-4 sm:px-6 pt-28 pb-4 xl:pb-12">
    <div class="max-w-2xl" data-hero-text>
      <p class="reveal inline-flex items-center gap-2 chip !text-xs !py-2 !px-3 mb-6">
        <span class="relative flex h-2 w-2">
          <span class="absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75 animate-ping"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-cyan"></span>
        </span>
        {profile.role} @ {profile.company} · {profile.location}
      </p>

      <h1 class="reveal font-display font-bold tracking-tight text-5xl sm:text-6xl lg:text-7xl leading-[1.02]">
        {profile.name}
      </h1>
      <p class="reveal mt-5 font-display text-2xl sm:text-3xl lg:text-4xl font-semibold leading-tight">
        <span class="text-gradient">{profile.headline}</span>
      </p>

      <p class="reveal mt-6 font-mono text-sm sm:text-base text-muted">
        <span class="text-amber">embedded</span> <span aria-hidden="true">→</span> <span class="text-cyan">ai</span> <span aria-hidden="true">::</span>
        <span id="typed" class="text-fg">{profile.rotating[0]}</span><span class="caret" aria-hidden="true"></span>
      </p>

      <p class="reveal mt-6 text-base sm:text-lg text-muted leading-relaxed max-w-xl">{profile.summary}</p>

      <div class="reveal mt-8 flex flex-wrap gap-3">
        <a href={url('/projects')} class="btn btn-primary">View projects <Icon name="arrow" class="w-4 h-4" /></a>
        {profile.showResumePdf
          ? <a href={url(`/${profile.resumePdf}`)} class="btn btn-ghost" download><Icon name="download" class="w-4 h-4" /> Download CV</a>
          : <a href={url('/resume')} class="btn btn-ghost">Resume <Icon name="arrow" class="w-4 h-4" /></a>}
        <a href={url('/#contact')} class="btn btn-ghost">Contact</a>
      </div>

      <div class="reveal mt-8 flex items-center gap-5 text-muted">
        <a href={profile.socials.linkedin} target="_blank" rel="noopener" aria-label="LinkedIn" class="hover:text-cyan transition-colors"><Icon name="linkedin" class="w-6 h-6" /></a>
        <a href={profile.socials.github} target="_blank" rel="noopener" aria-label="GitHub" class="hover:text-cyan transition-colors"><Icon name="github" class="w-6 h-6" /></a>
        <a href={`mailto:${profile.email}`} aria-label="Email" class="hover:text-cyan transition-colors"><Icon name="mail" class="w-6 h-6" /></a>
      </div>
    </div>
  </div>

  {profile.showPhoto && (
    <div data-hero-photo class="pointer-events-none relative z-10 mx-auto w-[78vw] max-w-[340px] xl:absolute xl:right-0 xl:bottom-0 xl:mx-0 xl:w-[52vw] xl:max-w-[780px]">
      <div class="animate-float absolute inset-x-[6%] top-[4%] bottom-0 rounded-full bg-[radial-gradient(closest-side,color-mix(in_srgb,var(--cyan)_26%,transparent),color-mix(in_srgb,var(--violet)_12%,transparent)_55%,transparent_75%)]" aria-hidden="true"></div>
      <div class="reveal relative [mask-image:linear-gradient(to_bottom,#000_84%,transparent_100%)] [-webkit-mask-image:linear-gradient(to_bottom,#000_84%,transparent_100%)]">
        <Image src={portrait} alt="Swapnil Alase" widths={[720, 1080, 1422]} sizes="(min-width: 1280px) 52vw, 78vw" quality={90} loading="eager" fetchpriority="high" decoding="async" class="block w-full h-auto" />
        <div class="det-box absolute" style={`left:${profile.photoFace.left}%;top:${profile.photoFace.top}%;width:${profile.photoFace.width}%;height:${profile.photoFace.height}%`} aria-hidden="true"><span class="det-label">swapnil 0.99</span></div>
      </div>
    </div>
  )}

  <a href="#about" class="no-print absolute bottom-8 left-1/2 -translate-x-1/2 text-muted hover:text-cyan animate-float hidden sm:[@media(min-height:760px)]:block" aria-label="Scroll to about">
    <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 5v14m0 0-6-6m6 6 6-6"/></svg>
  </a>
</section>

<style>
  .det-box { --c: var(--cyan); border: 1px solid color-mix(in srgb, var(--c) 35%, transparent); }
  .det-box::before, .det-box::after { content: ''; position: absolute; width: 14px; height: 14px; border: 2px solid var(--c); }
  .det-box::before { left: -1px; top: -1px; border-right: 0; border-bottom: 0; }
  .det-box::after { right: -1px; bottom: -1px; border-left: 0; border-top: 0; }
  .det-label { position: absolute; left: -1px; top: -19px; padding: 2px 6px; border-radius: 3px; font: 500 10px/14px var(--font-mono); color: var(--bg); background: var(--c); white-space: nowrap; }
</style>

<script define:vars={{ words: profile.rotating }}>
  const el = document.getElementById('typed');
  if (el && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let w = 0, i = words[0].length, deleting = true;
    const tick = () => {
      const word = words[w];
      i += deleting ? -1 : 1;
      el.textContent = word.slice(0, i);
      let delay = deleting ? 40 : 80;
      if (!deleting && i === word.length) { deleting = true; delay = 2000; }
      else if (deleting && i === 0) { deleting = false; w = (w + 1) % words.length; delay = 300; }
      setTimeout(tick, delay);
    };
    setTimeout(tick, 2200);
  }
</script>
