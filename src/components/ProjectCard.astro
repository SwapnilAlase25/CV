---
import Icon from './Icon.astro';
import { url } from '../utils/url';
import type { CollectionEntry } from 'astro:content';

interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const d = project.data;
const catLabel = { ai: 'AI / ML', embedded: 'Embedded', foundation: 'Data foundations' }[d.category];
const catChip = { ai: 'chip-ai', embedded: 'chip-embedded', foundation: 'chip-violet' }[d.category];
const statusLabel = { live: '', building: 'In progress', archived: '' }[d.status];
---
<article class="reveal card card-hover group flex flex-col p-6 h-full">
  <div class="flex items-center justify-between gap-2">
    <span class={`chip ${catChip}`}>{catLabel}</span>
    {statusLabel && <span class="chip chip-violet"><span class="w-1.5 h-1.5 rounded-full bg-violet animate-pulse"></span>{statusLabel}</span>}
  </div>
  <h3 class="mt-4 font-display font-semibold text-xl leading-snug group-hover:text-cyan transition-colors">
    <a href={url(`/projects/${project.id}`)} class="after:absolute after:inset-0">{d.title}</a>
  </h3>
  <p class="mt-3 text-sm text-muted leading-relaxed flex-1">{d.summary}</p>
  {d.metrics.length > 0 && (
    <div class="mt-4 flex flex-wrap gap-x-4 gap-y-1 font-mono text-xs text-fg">
      {d.metrics.map((m) => <span>▹ {m}</span>)}
    </div>
  )}
  <div class="mt-4 flex flex-wrap gap-1.5">{d.tags.slice(0, 5).map((t) => <span class="chip">{t}</span>)}</div>
  <div class="mt-5 flex items-center gap-4 text-sm relative z-10">
    <span class="inline-flex items-center gap-1 text-cyan">Read more <Icon name="arrow" class="w-4 h-4 group-hover:translate-x-1 transition-transform" /></span>
    {d.github && <a href={d.github} target="_blank" rel="noopener" class="text-muted hover:text-fg inline-flex items-center gap-1"><Icon name="github" class="w-4 h-4" />Code</a>}
    {d.demo && <a href={d.demo} target="_blank" rel="noopener" class="text-muted hover:text-fg inline-flex items-center gap-1"><Icon name="external" class="w-4 h-4" />Demo</a>}
  </div>
</article>
