---
interface Props { label: string; title: string; subtitle?: string; }
const { label, title, subtitle } = Astro.props;
---
<div class="reveal mb-8">
  <p class="section-label">{label}</p>
  <h2 class="mt-3 font-display font-bold text-3xl sm:text-4xl tracking-tight">{title}</h2>
  {subtitle && <p class="mt-4 text-muted max-w-2xl leading-relaxed">{subtitle}</p>}
</div>
