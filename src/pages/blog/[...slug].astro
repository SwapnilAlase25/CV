---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { render } from 'astro:content';
import { getPosts } from '../../utils/content';
import { url, formatDate, readingTime } from '../../utils/url';
import { profile } from '../../data/profile';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
---
<BaseLayout title={post.data.title} description={post.data.description} type="article">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 pt-32 pb-12 lg:grid lg:grid-cols-[1fr_14rem] lg:gap-12">
    <article class="max-w-3xl">
      <a href={url('/blog')} class="text-sm text-muted hover:text-cyan">← All posts</a>
      <p class="mt-6 font-mono text-xs text-muted">{formatDate(post.data.date)} · {readingTime(post.body)}{post.data.draft && ' · DRAFT'}</p>
      <h1 class="mt-3 font-display font-bold text-4xl sm:text-5xl tracking-tight leading-tight">{post.data.title}</h1>
      <p class="mt-5 text-lg text-muted leading-relaxed">{post.data.description}</p>
      <div class="mt-5 flex flex-wrap gap-1.5">{post.data.tags.map((t) => <span class="chip">#{t}</span>)}</div>
      <hr class="my-10 border-line" />
      <div class="prose prose-site max-w-none prose-lg">
        <Content />
      </div>
      <div class="mt-16 card p-6 flex items-center gap-4">
        <div class="w-12 h-12 shrink-0 rounded-xl grid place-items-center font-display font-bold text-[#041018] bg-gradient-to-br from-amber via-cyan to-violet">{profile.initials}</div>
        <div>
          <p class="font-semibold">{profile.name}</p>
          <p class="text-sm text-muted">{profile.role} · writing about AI, Edge AI and engineering.</p>
        </div>
      </div>
    </article>
    {toc.length > 1 && (
      <aside class="hidden lg:block">
        <div class="sticky top-28">
          <p class="font-mono text-xs uppercase tracking-widest text-muted">On this page</p>
          <ul class="mt-4 space-y-2 text-sm border-l border-line">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="block pl-4 -ml-px border-l border-transparent text-muted hover:text-cyan hover:border-cyan">{h.text}</a></li>)}
          </ul>
        </div>
      </aside>
    )}
  </div>
</BaseLayout>
