---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import NNPlayground from '../../components/NNPlayground.astro';
import { render } from 'astro:content';
import { getProjects } from '../../utils/content';
import { url } from '../../utils/url';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((project) => ({ params: { slug: project.id }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
const d = project.data;
const cat = { ai: ['AI', 'chip-ai'], embedded: ['Embedded', 'chip-embedded'], foundation: ['Data foundations', 'chip-violet'] }[d.category];
---
<BaseLayout title={d.title} description={d.summary} type="article">
  <article class="mx-auto max-w-3xl px-4 sm:px-6 pt-32 pb-12">
    <a href={url('/projects')} class="text-sm text-muted hover:text-cyan">← All projects</a>
    <div class="mt-6 flex flex-wrap gap-2">
      <span class={`chip ${cat[1]}`}>{cat[0]}</span>
      {d.status === 'building' && <span class="chip chip-violet">In progress</span>}
    </div>
    <h1 class="mt-4 font-display font-bold text-4xl sm:text-5xl tracking-tight leading-tight">{d.title}</h1>
    <p class="mt-5 text-lg text-muted leading-relaxed">{d.summary}</p>
    {d.metrics.length > 0 && (
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-3 gap-3">
        {d.metrics.map((m) => <div class="card p-4 text-center font-mono text-sm">{m}</div>)}
      </div>
    )}
    <div class="mt-6 flex flex-wrap gap-2">{d.tags.map((t) => <span class="chip">{t}</span>)}</div>
    {(d.github || d.demo) && (
      <div class="mt-6 flex gap-3">
        {d.github && <a href={d.github} target="_blank" rel="noopener" class="btn btn-ghost"><Icon name="github" class="w-4 h-4" /> Source code</a>}
        {d.demo && <a href={d.demo} target="_blank" rel="noopener" class="btn btn-primary"><Icon name="external" class="w-4 h-4" /> Live demo</a>}
      </div>
    )}
    {d.roadmap.length > 0 && (
      <ol class="mt-8 card p-5 space-y-2.5">
        {d.roadmap.map((r, i) => (
          <li class="flex items-center gap-3 text-sm">
            <span class={`grid place-items-center w-6 h-6 rounded-full font-mono text-[10px] ${r.status === 'done' ? 'bg-cyan text-bg' : r.status === 'active' ? 'border-2 border-cyan text-cyan' : 'border border-line text-muted'}`}>{r.status === 'done' ? '✓' : i + 1}</span>
            <span class={r.status === 'todo' ? 'text-muted' : 'text-fg'}>{r.label}</span>
            {r.status === 'active' && <span class="font-mono text-[10px] text-cyan">← now</span>}
          </li>
        ))}
      </ol>
    )}
    {d.playground && <div class="mt-8"><NNPlayground /></div>}
    <hr class="my-10 border-line" />
    <div class="prose prose-site max-w-none">
      <Content />
    </div>
  </article>
</BaseLayout>
