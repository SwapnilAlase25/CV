---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { url } from '../utils/url';

const pdf = url(`/${profile.resumePdf}`);
---
<BaseLayout title="Resume" description={`Resume of ${profile.name}, ${profile.role}.`}>
  <div class="mx-auto max-w-5xl px-4 sm:px-6 pt-28 pb-12">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-6">
      <div>
        <a href={url('/')} class="text-sm text-muted hover:text-cyan">← Home</a>
        <h1 class="mt-2 font-display font-bold text-3xl sm:text-4xl tracking-tight">Resume</h1>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href={pdf} class="btn btn-primary" download><Icon name="download" class="w-4 h-4" /> Download PDF</a>
        <a href={pdf} class="btn btn-ghost" target="_blank" rel="noopener"><Icon name="external" class="w-4 h-4" /> Open in new tab</a>
      </div>
    </div>

    <div id="pdf-viewer" class="card overflow-hidden">
      <object data={`${pdf}#view=FitH&navpanes=0`} type="application/pdf" class="block w-full h-[80vh] min-h-[560px]" aria-label={`${profile.name} resume (PDF)`}></object>
    </div>

    <div id="pdf-fallback" class="card hidden p-8 sm:p-12 text-center">
      <p class="text-muted">Your browser can’t display the PDF inline. Use the buttons to read or save it.</p>
      <div class="mt-5 flex flex-wrap justify-center gap-3">
        <a href={pdf} class="btn btn-primary" download><Icon name="download" class="w-4 h-4" /> Download PDF</a>
        <a href={pdf} class="btn btn-ghost" target="_blank" rel="noopener"><Icon name="external" class="w-4 h-4" /> Open in new tab</a>
      </div>
    </div>
  </div>

  <script>
    // Browsers without a built-in PDF viewer (e.g. most phones) get a compact download panel instead of a blank box.
    if (navigator.pdfViewerEnabled === false) {
      document.getElementById('pdf-viewer')?.classList.add('hidden');
      document.getElementById('pdf-fallback')?.classList.remove('hidden');
    }
  </script>
</BaseLayout>
