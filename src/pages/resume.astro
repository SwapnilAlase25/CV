---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { profile, experience, skills, education, certifications, publications } from '../data/profile';
import { getProjects } from '../utils/content';
import { url } from '../utils/url';

const projects = (await getProjects()).filter((p) => p.data.status !== 'building').slice(0, 4);
---
<BaseLayout title="Resume" description={`Resume of ${profile.name}, ${profile.role}.`}>
  <div class="mx-auto max-w-4xl px-4 sm:px-6 pt-28 pb-12">
    <div class="no-print flex flex-wrap items-center justify-between gap-3 mb-6">
      <a href={url('/')} class="text-sm text-muted hover:text-cyan">← Home</a>
      <div class="flex gap-3">
        {profile.showResumePdf && <a href={url(`/${profile.resumePdf}`)} class="btn btn-ghost" download><Icon name="download" class="w-4 h-4" /> PDF</a>}
        <button onclick="window.print()" class="btn btn-primary"><Icon name="print" class="w-4 h-4" /> Print / Save as PDF</button>
      </div>
    </div>

    <article class="card print-plain p-6 sm:p-12 text-[15px] leading-relaxed">
      <header class="border-b border-line pb-6">
        <h1 class="font-display font-bold text-4xl tracking-tight">{profile.name}</h1>
        <p class="mt-1 text-lg text-gradient-ai font-semibold">{profile.role}</p>
        <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
          <span>{profile.location}</span>
          <a href={`mailto:${profile.email}`} class="hover:text-cyan">{profile.email}</a>
          <a href={profile.socials.linkedin} class="hover:text-cyan">linkedin.com/in/swapnilalase</a>
          <a href={profile.socials.github} class="hover:text-cyan">github.com/swapnilalase25</a>
        </p>
      </header>

      <section class="mt-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-cyan">Summary</h2>
        <p class="mt-2">{profile.summary}</p>
      </section>

      <section class="mt-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-cyan">Experience</h2>
        {experience.map((job) => (
          <div class="mt-4">
            <p class="font-semibold">{job.company}{job.team && ` — ${job.team}`} <span class="font-normal text-muted">· {job.location}</span></p>
            {job.roles.map((r) => (
              <div class="mt-2">
                <p class="italic">{r.title}</p>
                <ul class="list-disc pl-5 mt-1 space-y-0.5">{r.points.map((p) => <li>{p}</li>)}</ul>
              </div>
            ))}
          </div>
        ))}
      </section>

      <section class="mt-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-cyan">Skills</h2>
        <p class="mt-2"><strong>AI / Data:</strong> {skills.ai.items.join(', ')}</p>
        <p class="mt-1"><strong>Embedded:</strong> {skills.embedded.items.join(', ')}</p>
      </section>

      <section class="mt-6">
        <h2 class="font-mono text-xs uppercase tracking-widest text-cyan">Selected projects</h2>
        <ul class="mt-2 space-y-2">
          {projects.map((p) => <li><strong>{p.data.title}</strong> — {p.data.summary}</li>)}
        </ul>
      </section>

      <section class="mt-6 grid sm:grid-cols-2 gap-6">
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-cyan">Education</h2>
          <ul class="mt-2 space-y-1.5">{education.map((e) => <li><strong>{e.degree}</strong><br /><span class="text-muted">{e.school}</span></li>)}</ul>
        </div>
        <div>
          <h2 class="font-mono text-xs uppercase tracking-widest text-cyan">Certifications & publication</h2>
          <ul class="mt-2 space-y-1">
            {certifications.map((c) => <li>{c}</li>)}
            {publications.map((p) => <li>{p.title} — {p.venue}, {p.year}</li>)}
          </ul>
        </div>
      </section>
    </article>
  </div>
</BaseLayout>
